# Whee Development Environment Configuration
# Copy this file to .env.local and update with your local IP

# Backend API URL
# For iOS device testing: Use your machine's local IP address
# Find your IP: Windows: ipconfig, Mac/Linux: ifconfig
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

EXPO_PUBLIC_API_URL=http://localhost:3001
